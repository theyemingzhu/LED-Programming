diff --git a/firmware/lightweaver-controller/src/LightweaverCrashRecord.h b/firmware/lightweaver-controller/src/LightweaverCrashRecord.h
new file mode 100644
index 00000000..502fb345
--- /dev/null
+++ b/firmware/lightweaver-controller/src/LightweaverCrashRecord.h
@@ -0,0 +1,216 @@
+#pragma once
+
+// Crash recorder: the part that needs no hardware. See todo/plans/crash-recorder.md.
+//
+// Two records, one codec:
+//   Breadcrumb  lives in RTC_NOINIT memory, refreshed by the running firmware
+//               every few seconds. A watchdog reset gives no chance to write
+//               anything, so the last breadcrumb is the only witness.
+//   CrashRecord the breadcrumb promoted at the next boot when the reset reason
+//               says the card crashed. It is the one thing written to flash
+//               (NVS), once per crash, and /api/status reports it.
+//
+// No Arduino or ESP-IDF include is needed here, so the same header compiles on
+// the host. Reset reason numbers are esp_reset_reason_t as the card reports
+// them in /api/status "resetReason".
+
+#include <cstddef>
+#include <cstdint>
+#include <cstdio>
+#include <cstring>
+
+namespace lightweaver {
+
+constexpr uint32_t kCrashMagic = 0x4C574352U;  // "LWCR"
+constexpr uint8_t kCrashVersion = 1;
+constexpr size_t kCrashBacktraceDepth = 16;
+constexpr size_t kCrashTaskNameLength = 16;
+
+enum ResetReasonCode : uint8_t {
+  kResetUnknown = 0,
+  kResetPowerOn = 1,
+  kResetExternal = 2,
+  kResetSoftware = 3,
+  kResetPanic = 4,
+  kResetIntWatchdog = 5,
+  kResetTaskWatchdog = 6,
+  kResetOtherWatchdog = 7,
+  kResetDeepSleep = 8,
+  kResetBrownout = 9,
+};
+
+// What the firmware was doing when it last checked in. Set around the long or
+// risky operations so a watchdog reset can still name the suspect.
+enum CrashPhase : uint8_t {
+  kPhaseIdle = 0,
+  kPhaseRender = 1,
+  kPhaseConfigSave = 2,
+  kPhaseWifi = 3,
+  kPhaseStorage = 4,
+  kPhaseUpdate = 5,
+  kPhaseHttp = 6,
+};
+
+struct Breadcrumb {
+  uint32_t magic;
+  uint8_t version;
+  uint8_t phase;
+  uint8_t backtraceLength;
+  uint8_t reserved;
+  uint32_t uptimeMs;
+  uint32_t freeHeap;
+  uint32_t minFreeHeap;
+  uint32_t pc;  // 0 unless a panic hook filled it in
+  uint32_t backtrace[kCrashBacktraceDepth];
+  char task[kCrashTaskNameLength];
+  uint32_t checksum;
+};
+
+struct CrashRecord {
+  uint32_t magic;
+  uint8_t version;
+  uint8_t resetReason;
+  uint8_t phase;
+  uint8_t backtraceLength;
+  uint32_t sequence;  // 1 for the first crash ever recorded, then counts up
+  uint32_t uptimeMs;
+  uint32_t freeHeap;
+  uint32_t minFreeHeap;
+  uint32_t pc;
+  uint32_t backtrace[kCrashBacktraceDepth];
+  char task[kCrashTaskNameLength];
+  uint32_t checksum;
+};
+
+inline uint32_t crashChecksum(const void* record, size_t sizeWithoutChecksum) {
+  const uint8_t* bytes = static_cast<const uint8_t*>(record);
+  uint32_t hash = 2166136261U;
+  for (size_t index = 0; index < sizeWithoutChecksum; index++) {
+    hash ^= bytes[index];
+    hash *= 16777619U;
+  }
+  return hash;
+}
+
+inline void sealBreadcrumb(Breadcrumb& crumb) {
+  crumb.magic = kCrashMagic;
+  crumb.version = kCrashVersion;
+  crumb.task[kCrashTaskNameLength - 1] = '\0';
+  crumb.checksum = crashChecksum(&crumb, offsetof(Breadcrumb, checksum));
+}
+
+inline bool breadcrumbValid(const Breadcrumb& crumb) {
+  return crumb.magic == kCrashMagic && crumb.version == kCrashVersion &&
+      crumb.backtraceLength <= kCrashBacktraceDepth &&
+      crumb.checksum == crashChecksum(&crumb, offsetof(Breadcrumb, checksum));
+}
+
+inline void sealCrashRecord(CrashRecord& record) {
+  record.magic = kCrashMagic;
+  record.version = kCrashVersion;
+  record.task[kCrashTaskNameLength - 1] = '\0';
+  record.checksum = crashChecksum(&record, offsetof(CrashRecord, checksum));
+}
+
+inline bool crashRecordValid(const CrashRecord& record) {
+  return record.magic == kCrashMagic && record.version == kCrashVersion &&
+      record.backtraceLength <= kCrashBacktraceDepth && record.sequence > 0 &&
+      record.checksum == crashChecksum(&record, offsetof(CrashRecord, checksum));
+}
+
+// A crash is a reset the card did not ask for and the owner did not cause.
+// Power-on, external pin, software restart (our own ESP.restart) and deep sleep
+// are normal. Brownout is a power fault, not firmware, but it is still worth
+// reporting, so it counts.
+inline bool resetReasonIsCrash(uint8_t reason) {
+  return reason == kResetPanic || reason == kResetIntWatchdog ||
+      reason == kResetTaskWatchdog || reason == kResetOtherWatchdog ||
+      reason == kResetBrownout;
+}
+
+inline const char* resetReasonName(uint8_t reason) {
+  switch (reason) {
+    case kResetPowerOn: return "powerOn";
+    case kResetExternal: return "external";
+    case kResetSoftware: return "software";
+    case kResetPanic: return "panic";
+    case kResetIntWatchdog: return "interruptWatchdog";
+    case kResetTaskWatchdog: return "taskWatchdog";
+    case kResetOtherWatchdog: return "watchdog";
+    case kResetDeepSleep: return "deepSleep";
+    case kResetBrownout: return "brownout";
+    default: return "unknown";
+  }
+}
+
+inline const char* crashPhaseName(uint8_t phase) {
+  switch (phase) {
+    case kPhaseIdle: return "idle";
+    case kPhaseRender: return "render";
+    case kPhaseConfigSave: return "configSave";
+    case kPhaseWifi: return "wifi";
+    case kPhaseStorage: return "storage";
+    case kPhaseUpdate: return "update";
+    case kPhaseHttp: return "http";
+    default: return "unknown";
+  }
+}
+
+// Decide at boot. `crumb` is whatever RTC memory held; `stored` is the record
+// already in NVS (may be invalid or empty). Returns true when `out` holds a
+// record that must be written to NVS. The caller clears the RTC breadcrumb
+// afterwards so one crash is never counted twice.
+inline bool promoteBreadcrumb(const Breadcrumb& crumb, uint8_t resetReason,
+                              const CrashRecord& stored, CrashRecord& out) {
+  if (!resetReasonIsCrash(resetReason)) return false;
+  std::memset(&out, 0, sizeof(out));
+  out.resetReason = resetReason;
+  out.sequence = (crashRecordValid(stored) ? stored.sequence : 0U) + 1U;
+  if (breadcrumbValid(crumb)) {
+    out.phase = crumb.phase;
+    out.uptimeMs = crumb.uptimeMs;
+    out.freeHeap = crumb.freeHeap;
+    out.minFreeHeap = crumb.minFreeHeap;
+    out.pc = crumb.pc;
+    out.backtraceLength = crumb.backtraceLength;
+    std::memcpy(out.backtrace, crumb.backtrace, sizeof(out.backtrace));
+    std::memcpy(out.task, crumb.task, sizeof(out.task));
+  }
+  // An unreadable breadcrumb still records the crash and its reason: knowing
+  // that it happened, and how, is the floor. The detail fields stay zero.
+  sealCrashRecord(out);
+  return true;
+}
+
+// Writes the /api/status value of "lastCrash": `null`, or an object. Returns
+// the length written, or 0 if `capacity` is too small. Hex strings, not
+// numbers, for addresses: they are 32-bit and Studio must not round them.
+inline size_t crashRecordToJson(const CrashRecord& record, char* out, size_t capacity) {
+  if (!crashRecordValid(record)) {
+    if (capacity < 5) return 0;
+    std::memcpy(out, "null", 5);
+    return 4;
+  }
+  size_t used = 0;
+  auto put = [&](const char* format, auto... values) -> bool {
+    if (used >= capacity) return false;
+    const int written = std::snprintf(out + used, capacity - used, format, values...);
+    if (written < 0 || static_cast<size_t>(written) >= capacity - used) return false;
+    used += static_cast<size_t>(written);
+    return true;
+  };
+  bool ok = put("{\"sequence\":%u,\"resetReason\":%u,\"reason\":\"%s\",\"phase\":\"%s\","
+                "\"task\":\"%s\",\"uptimeMs\":%u,\"freeHeap\":%u,\"minFreeHeap\":%u,"
+                "\"pc\":\"0x%08x\",\"backtrace\":[",
+                static_cast<unsigned>(record.sequence), static_cast<unsigned>(record.resetReason),
+                resetReasonName(record.resetReason), crashPhaseName(record.phase), record.task,
+                static_cast<unsigned>(record.uptimeMs), static_cast<unsigned>(record.freeHeap),
+                static_cast<unsigned>(record.minFreeHeap), static_cast<unsigned>(record.pc));
+  for (size_t index = 0; ok && index < record.backtraceLength; index++) {
+    ok = put(index ? ",\"0x%08x\"" : "\"0x%08x\"", static_cast<unsigned>(record.backtrace[index]));
+  }
+  ok = ok && put("%s", "]}");
+  return ok ? used : 0;
+}
+
+}  // namespace lightweaver
diff --git a/firmware/lightweaver-controller/tests/crash-record.cpp b/firmware/lightweaver-controller/tests/crash-record.cpp
new file mode 100644
index 00000000..4dc9b36f
--- /dev/null
+++ b/firmware/lightweaver-controller/tests/crash-record.cpp
@@ -0,0 +1,195 @@
+// Host test for the crash recorder's pure parts. No card needed.
+// `crash-record <scenario>` prints the /api/status "lastCrash" value for a
+// scenario so crash-record.mjs can feed it to Studio's parser; with no argument
+// it runs the assertions.
+#include <cassert>
+#include <cstdio>
+#include <cstring>
+
+#include "../src/LightweaverCrashRecord.h"
+
+using namespace lightweaver;
+
+// Stand-ins for the two places a record lives. RTC memory survives a software
+// reset and a watchdog reset but not a power cut; NVS survives everything.
+// "Restart" here is a byte copy, which is exactly what the hardware does.
+struct SimulatedCard {
+  Breadcrumb rtc;
+  CrashRecord nvs;
+  void powerCut() { std::memset(&rtc, 0xA5, sizeof(rtc)); }  // RTC comes back as garbage
+};
+
+static Breadcrumb makeCrumb(uint8_t phase, uint32_t uptime, const char* task) {
+  Breadcrumb crumb;
+  std::memset(&crumb, 0, sizeof(crumb));
+  crumb.phase = phase;
+  crumb.uptimeMs = uptime;
+  crumb.freeHeap = 91234;
+  crumb.minFreeHeap = 40960;
+  std::strncpy(crumb.task, task, sizeof(crumb.task) - 1);
+  sealBreadcrumb(crumb);
+  return crumb;
+}
+
+// Boot as the firmware will: promote if the reset says crash, persist, clear RTC.
+static bool boot(SimulatedCard& card, uint8_t resetReason) {
+  CrashRecord fresh;
+  const bool promote = promoteBreadcrumb(card.rtc, resetReason, card.nvs, fresh);
+  if (promote) card.nvs = fresh;
+  std::memset(&card.rtc, 0, sizeof(card.rtc));
+  return promote;
+}
+
+static void printScenario(const char* name) {
+  SimulatedCard card;
+  std::memset(&card, 0, sizeof(card));
+  char json[512];
+  if (std::strcmp(name, "none") == 0) {
+  } else if (std::strcmp(name, "watchdog") == 0) {
+    card.rtc = makeCrumb(kPhaseConfigSave, 27252000U, "loopTask");
+    boot(card, kResetTaskWatchdog);
+  } else if (std::strcmp(name, "panic") == 0) {
+    card.rtc = makeCrumb(kPhaseRender, 1234U, "async_tcp");
+    card.rtc.pc = 0x420a1b2cU;
+    card.rtc.backtraceLength = 3;
+    card.rtc.backtrace[0] = 0x420a1b2cU;
+    card.rtc.backtrace[1] = 0x4037f001U;
+    card.rtc.backtrace[2] = 0x403800ffU;
+    sealBreadcrumb(card.rtc);
+    boot(card, kResetPanic);
+  }
+  assert(crashRecordToJson(card.nvs, json, sizeof(json)) > 0);
+  std::puts(json);
+}
+
+int main(int argc, char** argv) {
+  if (argc > 1) { printScenario(argv[1]); return 0; }
+
+  // Encode/decode: a sealed record validates, and any flipped bit breaks it.
+  {
+    CrashRecord record;
+    std::memset(&record, 0, sizeof(record));
+    record.sequence = 1;
+    record.resetReason = kResetPanic;
+    sealCrashRecord(record);
+    assert(crashRecordValid(record));
+    CrashRecord copy;
+    std::memcpy(&copy, &record, sizeof(record));
+    assert(crashRecordValid(copy));
+    copy.uptimeMs ^= 1U;
+    assert(!crashRecordValid(copy));
+    std::memcpy(&copy, &record, sizeof(record));
+    copy.version = 2;
+    assert(!crashRecordValid(copy));
+    std::memcpy(&copy, &record, sizeof(record));
+    copy.backtraceLength = kCrashBacktraceDepth + 1;
+    sealCrashRecord(copy);
+    assert(!crashRecordValid(copy));  // an over-long backtrace is never trusted
+    std::memset(&copy, 0, sizeof(copy));
+    assert(!crashRecordValid(copy));  // zeroed NVS: nothing recorded
+    std::memcpy(&copy, &record, sizeof(record));
+    copy.sequence = 0;
+    sealCrashRecord(copy);
+    assert(!crashRecordValid(copy));
+  }
+
+  // Which resets count as a crash.
+  {
+    const uint8_t crashes[] = {kResetPanic, kResetIntWatchdog, kResetTaskWatchdog, kResetOtherWatchdog, kResetBrownout};
+    for (uint8_t reason : crashes) {
+      assert(resetReasonIsCrash(reason));
+    }
+    const uint8_t normal[] = {kResetUnknown, kResetPowerOn, kResetExternal, kResetSoftware, kResetDeepSleep, 10, 200};
+    for (uint8_t reason : normal) {
+      assert(!resetReasonIsCrash(reason));
+    }
+    assert(std::strcmp(resetReasonName(kResetPanic), "panic") == 0);
+    assert(std::strcmp(resetReasonName(kResetTaskWatchdog), "taskWatchdog") == 0);
+    assert(std::strcmp(resetReasonName(77), "unknown") == 0);
+  }
+
+  // Persistence across a simulated restart: the watchdog case seen on 1.2.5.
+  {
+    SimulatedCard card;
+    std::memset(&card, 0, sizeof(card));
+    card.rtc = makeCrumb(kPhaseConfigSave, 27252000U, "loopTask");
+    assert(boot(card, kResetTaskWatchdog));
+    assert(crashRecordValid(card.nvs));
+    assert(card.nvs.sequence == 1);
+    assert(card.nvs.resetReason == kResetTaskWatchdog);
+    assert(card.nvs.phase == kPhaseConfigSave);
+    assert(card.nvs.uptimeMs == 27252000U);  // 7.57 h, as measured
+    assert(card.nvs.minFreeHeap == 40960U);
+    assert(std::strcmp(card.nvs.task, "loopTask") == 0);
+
+    // The next boots are ordinary. The record stays, and is not counted again.
+    CrashRecord kept;
+    std::memcpy(&kept, &card.nvs, sizeof(kept));
+    assert(!boot(card, kResetSoftware));
+    assert(!boot(card, kResetPowerOn));
+    assert(std::memcmp(&kept, &card.nvs, sizeof(kept)) == 0);
+
+    // A second crash counts up and replaces the first.
+    card.rtc = makeCrumb(kPhaseRender, 99U, "async_tcp");
+    assert(boot(card, kResetPanic));
+    assert(card.nvs.sequence == 2);
+    assert(card.nvs.resetReason == kResetPanic);
+    assert(std::strcmp(card.nvs.task, "async_tcp") == 0);
+  }
+
+  // A crash that lost its breadcrumb (power cut mid-crash, RTC garbage) is
+  // still recorded with its reason; only the detail is empty.
+  {
+    SimulatedCard card;
+    std::memset(&card, 0, sizeof(card));
+    card.powerCut();
+    assert(boot(card, kResetBrownout));
+    assert(crashRecordValid(card.nvs));
+    assert(card.nvs.sequence == 1);
+    assert(card.nvs.resetReason == kResetBrownout);
+    assert(card.nvs.uptimeMs == 0 && card.nvs.backtraceLength == 0 && card.nvs.task[0] == '\0');
+  }
+
+  // A damaged stored record restarts the count rather than trusting it.
+  {
+    SimulatedCard card;
+    std::memset(&card, 0xFF, sizeof(card.nvs));
+    card.rtc = makeCrumb(kPhaseIdle, 5U, "loopTask");
+    assert(boot(card, kResetPanic));
+    assert(card.nvs.sequence == 1);
+  }
+
+  // Clean boots with garbage RTC never invent a crash.
+  {
+    SimulatedCard card;
+    std::memset(&card, 0, sizeof(card));
+    card.powerCut();
+    assert(!boot(card, kResetPowerOn));
+    assert(!crashRecordValid(card.nvs));
+  }
+
+  // /api/status value: null when nothing was recorded, an object otherwise.
+  {
+    char json[512];
+    CrashRecord none;
+    std::memset(&none, 0, sizeof(none));
+    assert(crashRecordToJson(none, json, sizeof(json)) == 4);
+    assert(std::strcmp(json, "null") == 0);
+
+    SimulatedCard card;
+    std::memset(&card, 0, sizeof(card));
+    card.rtc = makeCrumb(kPhaseHttp, 8U, "t");
+    card.rtc.backtraceLength = kCrashBacktraceDepth;
+    for (size_t index = 0; index < kCrashBacktraceDepth; index++) card.rtc.backtrace[index] = 0x40000000U + index;
+    sealBreadcrumb(card.rtc);
+    assert(boot(card, kResetPanic));
+    const size_t length = crashRecordToJson(card.nvs, json, sizeof(json));
+    assert(length > 0 && length == std::strlen(json));
+    assert(length < 512);  // a full backtrace still fits the buffer /api/status will use
+    char tiny[16];
+    assert(crashRecordToJson(card.nvs, tiny, sizeof(tiny)) == 0);  // too small: refuses, never truncates
+  }
+
+  std::puts("crash-record tests passed");
+  return 0;
+}
diff --git a/firmware/lightweaver-controller/tests/crash-record.mjs b/firmware/lightweaver-controller/tests/crash-record.mjs
new file mode 100644
index 00000000..38e91693
--- /dev/null
+++ b/firmware/lightweaver-controller/tests/crash-record.mjs
@@ -0,0 +1,40 @@
+// Builds and runs the crash-record host test, then feeds the JSON the firmware
+// would put in /api/status "lastCrash" to Studio's parser, so the two sides of
+// the contract (todo/plans/crash-recorder.md) are checked against each other.
+import assert from 'node:assert/strict';
+import { execFileSync } from 'node:child_process';
+import { mkdtempSync, rmSync } from 'node:fs';
+import { tmpdir } from 'node:os';
+import { join } from 'node:path';
+import { describeCardCrash, parseCardCrashReport } from '../../../lightweaver/src/lib/cardCrashReport.js';
+
+const dir = mkdtempSync(join(tmpdir(), 'lw-crash-record-'));
+try {
+  const binary = join(dir, 'crash-record');
+  execFileSync(process.env.CXX || 'c++', [
+    '-std=c++17', '-Wall', '-Wextra', '-Werror', 'crash-record.cpp', '-o', binary,
+  ], { cwd: new URL('.', import.meta.url), stdio: 'inherit' });
+  execFileSync(binary, { stdio: 'inherit' });
+
+  const scenario = name => JSON.parse(execFileSync(binary, [name], { encoding: 'utf8' }));
+
+  assert.deepEqual(parseCardCrashReport({ lastCrash: scenario('none') }), { state: 'none', crash: null });
+
+  const watchdog = parseCardCrashReport({ lastCrash: scenario('watchdog') });
+  assert.equal(watchdog.state, 'recorded');
+  assert.equal(watchdog.crash.resetReason, 6);
+  assert.equal(watchdog.crash.reason, 'taskWatchdog');
+  assert.equal(watchdog.crash.phase, 'configSave');
+  assert.equal(watchdog.crash.hasBacktrace, false);
+  assert.match(describeCardCrash(watchdog), /task watchdog.*saving a project.*7\.57 hours/);
+
+  const panic = parseCardCrashReport({ lastCrash: scenario('panic') });
+  assert.equal(panic.state, 'recorded');
+  assert.equal(panic.crash.resetReason, 4);
+  assert.equal(panic.crash.pc, '0x420a1b2c');
+  assert.deepEqual(panic.crash.backtrace, ['0x420a1b2c', '0x4037f001', '0x403800ff']);
+  assert.equal(panic.crash.task, 'async_tcp');
+} finally {
+  rmSync(dir, { recursive: true, force: true });
+}
+console.log('crash-record contract tests passed');
