diff --git a/firmware/lightweaver-controller/src/LightweaverFirmwareBootHealth.h b/firmware/lightweaver-controller/src/LightweaverFirmwareBootHealth.h
index be3e19a0..dfc4ebe4 100644
--- a/firmware/lightweaver-controller/src/LightweaverFirmwareBootHealth.h
+++ b/firmware/lightweaver-controller/src/LightweaverFirmwareBootHealth.h
@@ -40,6 +40,34 @@ inline FirmwareBootEvidenceDecision evaluateFirmwareBootHandoffEvidence(
   return FirmwareBootEvidenceDecision::None;
 }
 
+// A rollback record lives in RTC memory, which survives every restart and
+// every USB flash. Without a note of which build it was first reported on, the
+// card repeats it forever and restamps it with whatever build is running: a
+// card flashed to build B over USB went on saying an update had rolled back
+// and "restored" build B (measured on lw-b0fe81f61b44, 2026-11-19).
+//
+// The record has one spare byte, so it holds a one-byte tag of the build that
+// first reported the rollback. The layout is unchanged on purpose: an older
+// build arms the record and a newer one reads it during an update, and a
+// record the new build could not read would fail its own health check.
+// Zero means "not reported yet", so a tag is never zero.
+inline uint8_t firmwareBuildTag(const char* buildId) {
+  uint32_t hash = 2166136261U;
+  for (const char* cursor = buildId ? buildId : ""; *cursor; cursor++) {
+    hash ^= static_cast<uint8_t>(*cursor);
+    hash *= 16777619U;
+  }
+  const uint8_t tag = static_cast<uint8_t>(hash ^ (hash >> 8) ^ (hash >> 16) ^ (hash >> 24));
+  return tag ? tag : 1;
+}
+
+// True when the rollback was first reported by a different build than the one
+// running now: the image has been replaced since, so the record describes a
+// card that no longer exists.
+inline bool firmwareRollbackRecordIsStale(uint8_t reportedByTag, uint8_t runningTag) {
+  return reportedByTag != 0 && reportedByTag != runningTag;
+}
+
 struct FirmwareBootHealthFacts {
   bool pendingVerification = false;
   bool compiledIdentityMatches = false;
diff --git a/firmware/lightweaver-controller/tests/firmware-boot-health.cpp b/firmware/lightweaver-controller/tests/firmware-boot-health.cpp
index 91ce1d46..8f3d44e4 100644
--- a/firmware/lightweaver-controller/tests/firmware-boot-health.cpp
+++ b/firmware/lightweaver-controller/tests/firmware-boot-health.cpp
@@ -70,5 +70,20 @@ int main() {
   assert(evaluateFirmwareBootHandoffEvidence(
       false, FirmwareBootHandoffOutcome::RollbackRequested, false) ==
       FirmwareBootEvidenceDecision::None);
+
+  // A rollback is reported by the build it restored. Zero means not reported.
+  using lightweaver::firmwareBuildTag;
+  using lightweaver::firmwareRollbackRecordIsStale;
+  const uint8_t restored = firmwareBuildTag("1111111111111111111111111111111111111111");
+  const uint8_t flashedLater = firmwareBuildTag("56c00ce80e638b779e94653be5bd9700e8339070");
+  assert(restored != 0 && flashedLater != 0 && firmwareBuildTag("") != 0 &&
+         firmwareBuildTag(nullptr) != 0 && firmwareBuildTag("dev") != 0);
+  assert(restored != flashedLater);
+  // First boot after the rollback: nothing recorded yet, so it is reported.
+  assert(!firmwareRollbackRecordIsStale(0, restored));
+  // The same build restarting keeps the diagnosis.
+  assert(!firmwareRollbackRecordIsStale(restored, restored));
+  // A different image flashed afterwards did not roll back.
+  assert(firmwareRollbackRecordIsStale(restored, flashedLater));
   return 0;
 }
