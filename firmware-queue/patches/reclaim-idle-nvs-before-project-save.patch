@@ -1509,6 +1509,16 @@ bool writeCandidateState(Preferences& prefs, WiringCandidateState state) {
   return prefs.putUChar(NVS_CANDIDATE_STATE_KEY, static_cast<uint8_t>(state)) > 0;
 }
 
+bool reclaimIdleCandidateState(Preferences& prefs) {
+  if (!prefs.isKey(NVS_CANDIDATE_STATE_KEY)) return true;
+  if (prefs.getType(NVS_CANDIDATE_STATE_KEY) != PT_U8 ||
+      prefs.getUChar(NVS_CANDIDATE_STATE_KEY, UINT8_MAX) != WIRING_CANDIDATE_NONE) {
+    return false;
+  }
+  return prefs.remove(NVS_CANDIDATE_STATE_KEY) &&
+      !prefs.isKey(NVS_CANDIDATE_STATE_KEY);
+}
+
 bool candidateIdMatches(Preferences& prefs, const String& activationId) {
